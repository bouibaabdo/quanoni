# انسخ هذا الملف إلى .env واملأ القيم
# في Vercel: Settings -> Environment Variables
#
# PostgreSQL (إنتاج):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/qanoni?schema=public"
# أو انشئ قاعدة مجانية على https://neon.tech أو https://supabase.com
#
# SQLite (تطوير محلي):
# DATABASE_URL="file:./dev.db"
#
DATABASE_URL="file:./dev.db"

# سر المصادقة — عيّن قيمة عشوائية طويلة في الإنتاج (مثال: openssl rand -hex 32)
AUTH_SECRET=""